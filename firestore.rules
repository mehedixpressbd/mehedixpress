rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signed(){return request.auth!=null;}function admin(){return signed()&&request.auth.uid=="3Z0MLHObZOay8OFFnhreMvbg0e53";}match /users/{uid}{allow create:if signed()&&request.auth.uid==uid&&request.resource.data.role=="customer";allow read,update:if signed()&&(request.auth.uid==uid||admin());allow delete:if admin();}match /products/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}match /categories/{id}{allow read:if true;allow write:if admin();}match /settings/{id}{allow read:if true;allow write:if admin();}match /orders/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=="Pending"&&request.resource.data.stockState=="none";allow read:if signed()&&(resource.data.userId==request.auth.uid||admin());allow update,delete:if admin();}match /stockMovements/{id}{allow read,write:if admin();}match /offlineSales/{id}{allow read,write:if admin();}match /purchases/{id}{allow read,write:if admin();}match /expenses/{id}{allow read,write:if admin();}match /{document=**}{allow read,write:if false;}}}